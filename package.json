{
  "name": "xiezuodao",
  "version": "0.3.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @island/web",
    "build": "npm run build -w @island/web",
    "start": "npm run start -w @island/web",
    "typecheck": "npm run typecheck -w @island/web",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:start": "node scripts/db.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:supabase": "supabase start",
    "format": "prettier --write apps/web/src packages scripts tests docs package.json apps/web/package.json apps/web/next.config.ts playwright.config.ts vitest.config.ts",
    "admin:init": "node scripts/admin-init.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "prettier": "^3.9.9",
    "supabase": "^2.80.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
