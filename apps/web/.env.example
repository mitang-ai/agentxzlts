# 开发默认值仅用于本地；生产使用独立 PostgreSQL、TLS 和持久化对象存储。
DATABASE_URL=postgresql://island:local-development-only@127.0.0.1:55432/postgres
APP_ORIGIN=http://localhost:3000
STORAGE_DIR=../../.data/files
# 可选 Supabase 私有对象存储（服务密钥仅在服务端使用）
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# 后台：只有受信代理覆盖来源头、且阻止绕过代理直连时才启用
# TRUST_PROXY=false
# 可选：基础设施备份状态入口（不代表本应用提供备份服务）
# BACKUP_STATUS_URL=https://your-infrastructure.example/backups
